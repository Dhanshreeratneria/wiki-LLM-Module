# Copy this file to .env and fill in your local Postgres connection.
#
# DATABASE_URL="postgresql://<user>:<password>@<host>:<port>/<database>"
DATABASE_URL="postgresql://wiki_user:wiki_pass@localhost:5432/llm_wiki"

# Absolute or relative (to mcp-server/) path to the repo root that contains
# wiki/ and raw/. Defaults to the parent folder of mcp-server/.
WIKI_ROOT="../"

# Hosted access policy: all, tier2-3, or tier3.
ACCESS_TIER="all"

# Required for hosted HTTP access. Keep this secret.
MCP_AUTH_TOKEN="f02004af9d449b17f536c7a5279b073120fd3e7b40d8f16c91c9f394c5c45cfa"
